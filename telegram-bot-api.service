[Unit]
Description=Telegram Bot API Server (local mode)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=raspberrypi
Group=raspberrypi
EnvironmentFile=/etc/telegram-bot-api.env
StateDirectory=telegram-bot-api
WorkingDirectory=/var/lib/telegram-bot-api
ExecStart=/usr/local/bin/telegram-bot-api --local --http-ip-address=127.0.0.1 --http-port=8081 --dir=/var/lib/telegram-bot-api
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
UMask=0077

[Install]
WantedBy=multi-user.target
